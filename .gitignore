# Environnements virtuels
.venv/

# Cache de tests
.pytest_cache/
.latex-integration-runtime/

# Réglages locaux PyCharm
.idea/

# Cache Python
__pycache__/
*.py[cod]

# Fichiers divers système/éditeur
.DS_Store
Thumbs.db

# Micro-tests de diagnostic LaTEI (artefacts temporaires, non commités)
.audit_f1/latei/micro_test_*

# Sorties temporaires d’audit et de génération
_audit_runtime/
_pass_normalizer/

# Artefacts d'audit/comparaison LaTeX (logs, caches de polices, PDF intermédiaires)
.audit_f1/

# Artefacts de compilation LaTeX (régénérés à chaque build)
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
docs/*.log

# Sorties locales de compilation Nuitka (voir scripts/build_windows_exe.ps1
# pour la recette de reconstruction, elle-même suivie par git)
build_nuitka/
dist/*.build/
dist/*.exe
dist/*.cmd
